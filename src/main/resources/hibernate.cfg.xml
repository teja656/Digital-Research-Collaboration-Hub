<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- Change password to match your MySQL root password -->
        <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/researchsphere_db?useSSL=false&amp;serverTimezone=UTC&amp;allowPublicKeyRetrieval=true</property>
        <property name="hibernate.connection.username">root</property>
        <property name="hibernate.connection.password"></property>

        <property name="hibernate.dialect">org.hibernate.dialect.MySQL8Dialect</property>
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>
        <!-- Use validate after DB script is imported; update auto-creates missing columns -->
        <property name="hibernate.hbm2ddl.auto">update</property>
        <property name="current_session_context_class">thread</property>

        <mapping class="com.researchsphere.entity.User"/>
        <mapping class="com.researchsphere.entity.Team"/>
        <mapping class="com.researchsphere.entity.TeamMember"/>
        <mapping class="com.researchsphere.entity.Project"/>
        <mapping class="com.researchsphere.entity.Task"/>
        <mapping class="com.researchsphere.entity.Milestone"/>
        <mapping class="com.researchsphere.entity.Discussion"/>
        <mapping class="com.researchsphere.entity.Comment"/>
        <mapping class="com.researchsphere.entity.Notification"/>
        <mapping class="com.researchsphere.entity.ActivityLog"/>
        <mapping class="com.researchsphere.entity.UploadedFile"/>
    </session-factory>
</hibernate-configuration>
